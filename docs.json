{
  "$schema": "https://mintlify.com/docs.json",
  "theme": "aspen",
  "name": "KineticVM",
  "description": "Identity, spending limits, and signed attestations for physical AI devices on Monad.",
  "colors": {
    "primary": "#836ef9",
    "light": "#a594ff",
    "dark": "#5b3fe6"
  },
  "logo": {
    "light": "/logo/light.svg",
    "dark": "/logo/dark.svg",
    "href": "https://kineticvm.xyz"
  },
  "favicon": "/favicon.png",
  "appearance": {
    "default": "dark",
    "strict": false
  },
  "background": {
    "color": {
      "light": "#fbfaf9",
      "dark": "#0b0616"
    }
  },
  "fonts": {
    "family": "Geist"
  },
  "icons": {
    "library": "lucide"
  },
  "styling": {
    "eyebrows": "section",
    "codeblocks": {
      "theme": {
        "light": "github-light",
        "dark": "github-dark-dimmed"
      }
    }
  },
  "thumbnails": {
    "preset": "headline",
    "appearance": "dark"
  },
  "banner": {
    "content": "KineticVM is live on Monad testnet. [Claim your first device in ten minutes →](/quickstart)",
    "dismissible": true
  },
  "navbar": {
    "links": [
      {
        "label": "Marketplace",
        "href": "https://marketplace.kineticvm.xyz"
      },
      {
        "type": "github",
        "href": "https://github.com/kineticVM-labs/kinetic-vm"
      }
    ],
    "primary": {
      "type": "button",
      "label": "Get started",
      "href": "/quickstart"
    }
  },
  "contextual": {
    "options": ["copy", "view", "chatgpt", "claude", "perplexity"],
    "display": "header"
  },
  "navigation": {
    "tabs": [
      {
        "tab": "Documentation",
        "icon": "book-open",
        "groups": [
          {
            "group": "Get started",
            "pages": ["index", "quickstart", "how-it-works"]
          },
          {
            "group": "Core protocol",
            "pages": [
              "concepts/identity",
              "concepts/vault",
              "concepts/attestations",
              "concepts/state",
              "concepts/records"
            ]
          },
          {
            "group": "Operating a device",
            "pages": ["operate/telegram", "operate/funding", "operate/ownership"]
          },
          {
            "group": "Building on KineticVM",
            "pages": [
              "build/overview",
              "build/plugins",
              "build/sops",
              "build/skills",
              "build/hardware"
            ]
          },
          {
            "group": "Data marketplace",
            "pages": ["marketplace/overview", "marketplace/listing", "marketplace/verification"]
          },
          {
            "group": "Trust and safety",
            "pages": ["security"]
          }
        ]
      },
      {
        "tab": "Tutorials",
        "icon": "graduation-cap",
        "groups": [
          {
            "group": "Tutorials",
            "pages": [
              "tutorials/overview",
              "tutorials/vending-machine",
              "tutorials/first-plugin",
              "tutorials/verify-dataset"
            ]
          }
        ]
      },
      {
        "tab": "Contracts",
        "icon": "file-code",
        "groups": [
          {
            "group": "Smart contracts",
            "pages": ["contracts/overview", "contracts/deployments"]
          },
          {
            "group": "Contract reference",
            "pages": [
              "contracts/kinetic-registry",
              "contracts/device-vault",
              "contracts/kinetic-attestor",
              "contracts/erc-8004"
            ]
          }
        ]
      },
      {
        "tab": "Reference",
        "icon": "square-terminal",
        "groups": [
          {
            "group": "Reference",
            "pages": [
              "reference/cli",
              "reference/configuration",
              "reference/agent-tools",
              "reference/marketplace-api"
            ]
          },
          {
            "group": "Resources",
            "pages": ["resources/faq", "resources/glossary", "resources/changelog"]
          }
        ]
      }
    ]
  },
  "footer": {
    "socials": {
      "x": "https://x.com/kineticvm",
      "github": "https://github.com/kineticVM-labs/kinetic-vm",
      "website": "https://kineticvm.xyz"
    },
    "links": [
      {
        "header": "Product",
        "items": [
          { "label": "Website", "href": "https://kineticvm.xyz" },
          { "label": "Claim a device", "href": "https://claim.kineticvm.xyz" },
          { "label": "Data marketplace", "href": "https://marketplace.kineticvm.xyz" }
        ]
      },
      {
        "header": "Developers",
        "items": [
          { "label": "Quickstart", "href": "/quickstart" },
          { "label": "Contract addresses", "href": "/contracts/deployments" },
          { "label": "GitHub", "href": "https://github.com/kineticVM-labs/kinetic-vm" }
        ]
      },
      {
        "header": "Monad",
        "items": [
          { "label": "Monad testnet explorer", "href": "https://testnet.monadvision.com" },
          { "label": "ERC-8004", "href": "https://eips.ethereum.org/EIPS/eip-8004" }
        ]
      }
    ]
  }
}
